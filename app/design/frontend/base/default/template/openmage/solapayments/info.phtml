<h3><?php echo $this->__('Sola Payments Information'); ?></h3>
<p>
    <?php if ($this->getTransactionId()): ?>
        <strong><?php echo $this->__('Transaction ID:') ?></strong> <?php echo $this->escapeHtml($this->getTransactionId()); ?><br/>
    <?php endif; ?>
    <?php if ($this->getAuthorizationCode()): ?>
        <strong><?php echo $this->__('Authorization Code:') ?></strong> <?php echo $this->escapeHtml($this->getAuthorizationCode()); ?><br/>
    <?php endif; ?>
</p>
