<?xml version="1.0"?>
<!--
    YSRTech_Solapayments storefront: card form script on checkout pages
    (YSRTech_UnifiedCheckout page, and the standard onepage checkout), Saved cards in My Account.
-->
<layout version="0.1.0">
    <solapayments_checkout_assets>
        <reference name="head">
            <block type="solapayments/scripts" name="solapayments.scripts"/>
            <action method="addItem"><type>skin_css</type><name>solapayments/card.css</name></action>
            <action method="addItem"><type>skin_js</type><name>solapayments/card.js</name></action>
        </reference>
    </solapayments_checkout_assets>

    <ysrtech_unifiedcheckout_index>
        <update handle="solapayments_checkout_assets"/>
        <reference name="head">
            <action method="addItem"><type>skin_js</type><name>solapayments/giftcard.js</name></action>
        </reference>
    </ysrtech_unifiedcheckout_index>

    <!-- Gift card field in the checkout summary (refreshed with it) -->
    <ysrtech_unifiedcheckout_sections_extend>
        <reference name="unifiedcheckout.summary.after_coupon">
            <block type="solapayments/giftcard" name="solapayments.giftcard" template="solapayments/giftcard.phtml"/>
        </reference>
    </ysrtech_unifiedcheckout_sections_extend>

    <!-- Gift card line in order, invoice and credit memo totals (account, print, e-mails) -->
    <sales_order_view>
        <reference name="order_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.order_totals"/>
        </reference>
    </sales_order_view>
    <sales_order_print>
        <reference name="order_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.order_totals"/>
        </reference>
    </sales_order_print>
    <sales_email_order_items>
        <reference name="order_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.order_totals"/>
        </reference>
    </sales_email_order_items>
    <sales_order_invoice>
        <reference name="invoice_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.invoice_totals"/>
        </reference>
    </sales_order_invoice>
    <sales_order_printinvoice>
        <reference name="invoice_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.invoice_totals"/>
        </reference>
    </sales_order_printinvoice>
    <sales_email_order_invoice_items>
        <reference name="invoice_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.invoice_totals"/>
        </reference>
    </sales_email_order_invoice_items>
    <sales_order_creditmemo>
        <reference name="creditmemo_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.creditmemo_totals"/>
        </reference>
    </sales_order_creditmemo>
    <sales_order_printcreditmemo>
        <reference name="creditmemo_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.creditmemo_totals"/>
        </reference>
    </sales_order_printcreditmemo>
    <sales_email_order_creditmemo_items>
        <reference name="creditmemo_totals">
            <block type="solapayments/sales_totals" name="solapayments.giftcard.creditmemo_totals"/>
        </reference>
    </sales_email_order_creditmemo_items>

    <checkout_onepage_index>
        <update handle="solapayments_checkout_assets"/>
    </checkout_onepage_index>

    <customer_account>
        <reference name="customer_account_navigation">
            <action method="addLink" translate="label" module="solapayments" ifconfig="payment/solapayments/vault_active">
                <name>solapayments_cards</name><path>solapayments/cards</path><label>Saved cards</label>
            </action>
        </reference>
    </customer_account>

    <solapayments_cards_index>
        <update handle="customer_account"/>
        <reference name="head">
            <action method="addItem"><type>skin_css</type><name>solapayments/card.css</name></action>
        </reference>
        <reference name="my.account.wrapper">
            <block type="solapayments/customer_cards" name="solapayments.cards" template="solapayments/customer/cards.phtml"/>
        </reference>
    </solapayments_cards_index>
</layout>
