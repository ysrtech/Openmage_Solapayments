<layout version="1.0">
    <default>
        <reference name="head">
            <action method="addJs"><script>openmage/solapayments/solapayments.js</script></action>
        </reference>
    </default>

    <adminhtml_sales_order_view>
        <reference name="left">
            <block type="solapayments/info" name="order.payment.info" template="openmage/solapayments/info.phtml"/>
        </reference>
    </adminhtml_sales_order_view>
</layout>
