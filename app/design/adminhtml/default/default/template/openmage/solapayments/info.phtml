<?php
/* @var $this Openmage_Solapayments_Block_Info */
?>
<div>
    <h4><?php echo $this->__('Sola Payment Information'); ?></h4>
    <table class="data-table">
        <tr>
            <td class="label"><strong><?php echo $this->__('Transaction ID:') ?></strong></td>
            <td><?php echo $this->escapeHtml($this->getTransactionId()); ?></td>
        </tr>
        <?php if ($this->getAuthorizationCode()): ?>
        <tr>
            <td class="label"><strong><?php echo $this->__('Authorization Code:') ?></strong></td>
            <td><?php echo $this->escapeHtml($this->getAuthorizationCode()); ?></td>
        </tr>
        <?php endif; ?>
        <tr>
            <td class="label"><strong><?php echo $this->__('Card Type:') ?></strong></td>
            <td><?php echo $this->getInfo('cc_type'); ?></td>
        </tr>
        <tr>
            <td class="label"><strong><?php echo $this->__('Card Number:') ?></strong></td>
            <td><?php echo $this->getInfo('cc_number'); ?></td>
        </tr>
    </table>
</div>
