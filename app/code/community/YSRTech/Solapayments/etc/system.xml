<?xml version="1.0"?>
<config>
    <sections>
        <payment>
            <groups>
                <solapayments translate="label comment" module="solapayments">
                    <label>Sola Payments (Cardknox)</label>
                    <comment><![CDATA[API key: Sola portal &gt; Settings &gt; Keys (transaction key).]]></comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>5</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <active translate="label">
                            <label>Enabled</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </active>
                        <title translate="label">
                            <label>Title</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </title>
                        <cardknox_transaction_key translate="label comment">
                            <label>API key (transaction key)</label>
                            <comment>Secret; used by the server only.</comment>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </cardknox_transaction_key>
                        <token_key translate="label comment">
                            <label>iFields key (token key)</label>
                            <comment><![CDATA[Public key from Sola portal &gt; Settings &gt; Keys. Used only by the Google Pay and Apple Pay buttons.]]></comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>35</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </token_key>
                        <ifields_version translate="label comment">
                            <label>iFields version</label>
                            <comment><![CDATA[Cardknox iFields library version used by the wallet buttons.]]></comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>36</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </ifields_version>
                        <payment_action translate="label">
                            <label>Payment action</label>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_paymentAction</source_model>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </payment_action>
                        <split_capture_enabled translate="label comment">
                            <label>Split capture</label>
                            <comment>Authorize once, capture in several invoices (cc:splitcapture).</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <depends><payment_action>authorize</payment_action></depends>
                        </split_capture_enabled>
                        <order_status translate="label">
                            <label>New order status</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_order_status_processing</source_model>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </order_status>
                        <vault_active translate="label comment">
                            <label>Saved cards</label>
                            <comment>Signed-in customers can save a card when they pay and pay with it next time; they manage their cards in their account.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </vault_active>
                        <level3_enabled translate="label comment">
                            <label>Level 3 data</label>
                            <comment>Sends tax, shipping, discount and line items with each transaction (lower rates for business cards).</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>110</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </level3_enabled>
                        <allowspecific translate="label">
                            <label>Payment from applicable countries</label>
                            <frontend_type>allowspecific</frontend_type>
                            <source_model>adminhtml/system_config_source_payment_allspecificcountries</source_model>
                            <sort_order>120</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </allowspecific>
                        <specificcountry translate="label">
                            <label>Payment from specific countries</label>
                            <frontend_type>multiselect</frontend_type>
                            <source_model>adminhtml/system_config_source_country</source_model>
                            <sort_order>130</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <can_be_empty>1</can_be_empty>
                            <depends><allowspecific>1</allowspecific></depends>
                        </specificcountry>
                        <giftcard_enabled translate="label comment">
                            <label>Sola gift cards</label>
                            <comment>Customers apply a Sola gift card in the checkout summary; it is charged when the order is placed. For orders fully paid by gift card, also enable Zero Subtotal Checkout.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>135</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </giftcard_enabled>
                        <giftcard_title translate="label">
                            <label>Gift card title</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>136</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends><giftcard_enabled>1</giftcard_enabled></depends>
                        </giftcard_title>
                        <giftcard_url translate="label">
                            <label>Gift card gateway URL</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>137</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <depends><giftcard_enabled>1</giftcard_enabled></depends>
                        </giftcard_url>
                        <debug translate="label comment">
                            <label>Debug log</label>
                            <comment>var/log/solapayments.log (keys and tokens are masked).</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>140</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </debug>
                        <cgi_url translate="label">
                            <label>Gateway URL</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>150</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </cgi_url>
                        <sort_order translate="label">
                            <label>Sort order</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>170</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </sort_order>
                    </fields>
                </solapayments>
                <solapayments_googlepay translate="label comment" module="solapayments">
                    <label>Sola Payments: Google Pay</label>
                    <comment><![CDATA[Uses the API key of Sola Payments (Cardknox) above. The button is shown in the payment step (HTTPS only).]]></comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>6</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <active translate="label">
                            <label>Enabled</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </active>
                        <title translate="label">
                            <label>Title</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </title>
                        <merchant_name translate="label comment">
                            <label>Merchant name</label>
                            <comment><![CDATA[Shown in the Google Pay sheet. Required.]]></comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </merchant_name>
                        <environment translate="label comment">
                            <label>Environment</label>
                            <comment><![CDATA[Test shows test cards only. Production needs the site approved by Google (Google Pay &amp; Wallet Console) for this domain.]]></comment>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_googleEnvironment</source_model>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </environment>
                        <button_color translate="label">
                            <label>Button colour</label>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_googleButtonColor</source_model>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </button_color>
                        <button_type translate="label">
                            <label>Button type</label>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_googleButtonType</source_model>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </button_type>
                        <payment_action translate="label comment">
                            <label>Payment action</label>
                            <comment><![CDATA[Split capture follows the Sola Payments (Cardknox) setting.]]></comment>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_paymentAction</source_model>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </payment_action>
                        <order_status translate="label">
                            <label>New order status</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_order_status_processing</source_model>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </order_status>
                        <allowspecific translate="label">
                            <label>Payment from applicable countries</label>
                            <frontend_type>allowspecific</frontend_type>
                            <source_model>adminhtml/system_config_source_payment_allspecificcountries</source_model>
                            <sort_order>90</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </allowspecific>
                        <specificcountry translate="label">
                            <label>Payment from specific countries</label>
                            <frontend_type>multiselect</frontend_type>
                            <source_model>adminhtml/system_config_source_country</source_model>
                            <can_be_empty>1</can_be_empty>
                            <sort_order>100</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <depends><allowspecific>1</allowspecific></depends>
                        </specificcountry>
                        <sort_order translate="label">
                            <label>Sort order</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>110</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </sort_order>
                    </fields>
                </solapayments_googlepay>
                <solapayments_applepay translate="label comment" module="solapayments">
                    <label>Sola Payments: Apple Pay</label>
                    <comment><![CDATA[Before enabling, register this site's domain for Apple Pay in the <a href="https://portal.solapayments.com/settings/gateway-settings/payment-methods" target="_blank" rel="noopener">Sola portal</a>. The button is shown in Safari on Apple devices with Apple Pay set up (HTTPS only).]]></comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>7</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <active translate="label">
                            <label>Enabled</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </active>
                        <title translate="label">
                            <label>Title</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </title>
                        <merchant_identifier translate="label comment">
                            <label>Merchant identifier</label>
                            <comment><![CDATA[Sola's Apple Pay merchant (merchant.cardknox.com) unless Sola gave you another one.]]></comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </merchant_identifier>
                        <button_color translate="label">
                            <label>Button colour</label>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_appleButtonColor</source_model>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </button_color>
                        <button_type translate="label">
                            <label>Button type</label>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_appleButtonType</source_model>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </button_type>
                        <payment_action translate="label comment">
                            <label>Payment action</label>
                            <comment><![CDATA[Split capture follows the Sola Payments (Cardknox) setting.]]></comment>
                            <frontend_type>select</frontend_type>
                            <source_model>solapayments/source_paymentAction</source_model>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </payment_action>
                        <order_status translate="label">
                            <label>New order status</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_order_status_processing</source_model>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </order_status>
                        <allowspecific translate="label">
                            <label>Payment from applicable countries</label>
                            <frontend_type>allowspecific</frontend_type>
                            <source_model>adminhtml/system_config_source_payment_allspecificcountries</source_model>
                            <sort_order>90</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </allowspecific>
                        <specificcountry translate="label">
                            <label>Payment from specific countries</label>
                            <frontend_type>multiselect</frontend_type>
                            <source_model>adminhtml/system_config_source_country</source_model>
                            <can_be_empty>1</can_be_empty>
                            <sort_order>100</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <depends><allowspecific>1</allowspecific></depends>
                        </specificcountry>
                        <sort_order translate="label">
                            <label>Sort order</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>110</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                        </sort_order>
                    </fields>
                </solapayments_applepay>
            </groups>
        </payment>
    </sections>
</config>
