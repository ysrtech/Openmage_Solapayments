<?xml version="1.0"?>
<!--
    YSRTech_Solapayments: Sola Payments (Cardknox) for OpenMage, ported from Sola's Magento 2
    module (cardknox/magento2_cardknox, MIT).

    Method "solapayments": a card entered in the payment form, or a saved card (Cardknox token)
    of the customer. Split capture, Level 3 data, refunds and voids from the admin, Sola gift
    cards.
-->
<config>
    <modules>
        <YSRTech_Solapayments>
            <version>2.2.0</version>
        </YSRTech_Solapayments>
    </modules>
    <global>
        <models>
            <solapayments>
                <class>YSRTech_Solapayments_Model</class>
                <resourceModel>solapayments_resource</resourceModel>
            </solapayments>
            <solapayments_resource>
                <class>YSRTech_Solapayments_Model_Resource</class>
                <entities>
                    <card>
                        <table>solapayments_card</table>
                    </card>
                </entities>
            </solapayments_resource>
        </models>
        <blocks>
            <solapayments>
                <class>YSRTech_Solapayments_Block</class>
            </solapayments>
        </blocks>
        <helpers>
            <solapayments>
                <class>YSRTech_Solapayments_Helper</class>
            </solapayments>
        </helpers>
        <sales>
            <quote>
                <totals>
                    <solapayments_giftcard>
                        <class>solapayments/total_quote</class>
                        <after>grand_total</after>
                    </solapayments_giftcard>
                </totals>
            </quote>
            <order_invoice>
                <totals>
                    <solapayments_giftcard>
                        <class>solapayments/total_invoice</class>
                        <after>grand_total</after>
                    </solapayments_giftcard>
                </totals>
            </order_invoice>
            <order_creditmemo>
                <totals>
                    <solapayments_giftcard>
                        <class>solapayments/total_creditmemo</class>
                        <after>grand_total</after>
                    </solapayments_giftcard>
                </totals>
            </order_creditmemo>
        </sales>
        <pdf>
            <totals>
                <solapayments_giftcard translate="title">
                    <title>Gift card</title>
                    <source_field>solapayments_giftcard_amount</source_field>
                    <amount_prefix>-</amount_prefix>
                    <font_size>7</font_size>
                    <display_zero>0</display_zero>
                    <sort_order>650</sort_order>
                </solapayments_giftcard>
            </totals>
        </pdf>
        <events>
            <sales_model_service_quote_submit_before>
                <observers>
                    <solapayments_giftcard_redeem>
                        <class>solapayments/observer</class>
                        <method>redeemGiftcard</method>
                    </solapayments_giftcard_redeem>
                </observers>
            </sales_model_service_quote_submit_before>
            <sales_model_service_quote_submit_failure>
                <observers>
                    <solapayments_giftcard_reissue>
                        <class>solapayments/observer</class>
                        <method>reissueOnFailure</method>
                    </solapayments_giftcard_reissue>
                </observers>
            </sales_model_service_quote_submit_failure>
            <sales_model_service_quote_submit_success>
                <observers>
                    <solapayments_giftcard_clear>
                        <class>solapayments/observer</class>
                        <method>clearCheckout</method>
                    </solapayments_giftcard_clear>
                </observers>
            </sales_model_service_quote_submit_success>
            <sales_order_invoice_register>
                <observers>
                    <solapayments_giftcard_invoice>
                        <class>solapayments/observer</class>
                        <method>invoiceRegister</method>
                    </solapayments_giftcard_invoice>
                </observers>
            </sales_order_invoice_register>
            <sales_order_creditmemo_refund>
                <observers>
                    <solapayments_giftcard_refund>
                        <class>solapayments/observer</class>
                        <method>creditmemoRefund</method>
                    </solapayments_giftcard_refund>
                </observers>
            </sales_order_creditmemo_refund>
            <payment_method_is_active>
                <observers>
                    <solapayments_giftcard_zero_total>
                        <class>solapayments/observer</class>
                        <method>zeroTotalMethods</method>
                    </solapayments_giftcard_zero_total>
                </observers>
            </payment_method_is_active>
            <order_cancel_after>
                <observers>
                    <solapayments_giftcard_cancel>
                        <class>solapayments/observer</class>
                        <method>orderCancel</method>
                    </solapayments_giftcard_cancel>
                </observers>
            </order_cancel_after>
        </events>
        <resources>
            <ysrtech_solapayments_setup>
                <setup>
                    <module>YSRTech_Solapayments</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </ysrtech_solapayments_setup>
        </resources>
    </global>
    <frontend>
        <routers>
            <solapayments>
                <use>standard</use>
                <args>
                    <module>YSRTech_Solapayments</module>
                    <frontName>solapayments</frontName>
                </args>
            </solapayments>
        </routers>
        <layout>
            <updates>
                <solapayments>
                    <file>solapayments.xml</file>
                </solapayments>
            </updates>
        </layout>
        <translate>
            <modules>
                <YSRTech_Solapayments>
                    <files>
                        <default>YSRTech_Solapayments.csv</default>
                    </files>
                </YSRTech_Solapayments>
            </modules>
        </translate>
        <secure_url>
            <solapayments>/solapayments/</solapayments>
        </secure_url>
    </frontend>
    <adminhtml>
        <layout>
            <updates>
                <solapayments>
                    <file>solapayments.xml</file>
                </solapayments>
            </updates>
        </layout>
        <translate>
            <modules>
                <YSRTech_Solapayments>
                    <files>
                        <default>YSRTech_Solapayments.csv</default>
                    </files>
                </YSRTech_Solapayments>
            </modules>
        </translate>
    </adminhtml>
    <default>
        <payment>
            <solapayments>
                <active>0</active>
                <model>solapayments/method_card</model>
                <title>Credit card</title>
                <payment_action>authorize</payment_action>
                <order_status>processing</order_status>
                <split_capture_enabled>0</split_capture_enabled>
                <vault_active>1</vault_active>
                <level3_enabled>0</level3_enabled>
                <cgi_url>https://x1.cardknox.com/gateway</cgi_url>
                <debug>0</debug>
                <allowspecific>0</allowspecific>
                <giftcard_enabled>0</giftcard_enabled>
                <giftcard_title>Gift card</giftcard_title>
                <giftcard_url>https://x1.cardknox.com/gatewayjson</giftcard_url>
                <cardknox_transaction_key backend_model="adminhtml/system_config_backend_encrypted"/>
                <token_key/>
                <ifields_version>3.5.2607.1401</ifields_version>
            </solapayments>
            <solapayments_googlepay>
                <active>0</active>
                <model>solapayments/method_googlepay</model>
                <title>Google Pay</title>
                <payment_action>authorize</payment_action>
                <order_status>processing</order_status>
                <merchant_name/>
                <environment>TEST</environment>
                <button_color>default</button_color>
                <button_type>pay</button_type>
                <allowspecific>0</allowspecific>
                <sort_order>3</sort_order>
            </solapayments_googlepay>
            <solapayments_applepay>
                <active>0</active>
                <model>solapayments/method_applepay</model>
                <title>Apple Pay</title>
                <payment_action>authorize</payment_action>
                <order_status>processing</order_status>
                <merchant_identifier>merchant.cardknox.com</merchant_identifier>
                <button_color>black</button_color>
                <button_type>pay</button_type>
                <allowspecific>0</allowspecific>
                <sort_order>4</sort_order>
            </solapayments_applepay>
        </payment>
    </default>
</config>
